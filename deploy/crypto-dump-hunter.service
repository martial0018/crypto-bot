[Unit]
Description=Crypto Pump & Dump Hunter (paper trading only)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cryptobot
Group=cryptobot
WorkingDirectory=/opt/crypto-dump-hunter
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/crypto-dump-hunter.env
ExecStart=/opt/crypto-dump-hunter/.venv/bin/python /opt/crypto-dump-hunter/bot.py
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/crypto-dump-hunter

[Install]
WantedBy=multi-user.target
